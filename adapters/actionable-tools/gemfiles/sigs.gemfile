# frozen_string_literal: true

# The signature tooling lane (sigs:*, release:check). Kept apart from the main Gemfile because Sord loads every
# bundled gem's rbi/ directory, and RuboCop's prism dependency ships one Parlour cannot parse.
source 'https://rubygems.org'

gemspec path: '..'

gem 'actionable-rb', path: '../../../gems/actionable'
gem 'field_struct', path: '../../../gems/field_struct'
gem 'field_struct-json_schema', path: '../../field_struct-json_schema'
gem 'rake', '~> 13.0'
gem 'rbs', '~> 3.0'
gem 'rspec', '~> 3.0'
gem 'sord', '~> 7.1.0'
gem 'yard', '~> 0.9'
