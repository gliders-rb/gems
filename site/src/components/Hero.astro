---
// Starlight's Hero, overridden for the home page only: the copy (mark, title, tagline, actions) beside the code
// animation that bin/hero generates from src/hero/storyboard.md. Any other splash page keeps Starlight's own hero.
//
// The figure is static HTML and renders as its final frame. The script below turns it into a stepper with
// autoplay; with scripts off the reader gets the finished figure and no controls.
import Default from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import demo from '../generated/hero.html?raw';
import timelineCss from '../generated/hero.css?raw';
import heroCss from '../styles/hero.css?raw';
import fieldStructMark from '../assets/brand/field-struct-mark.svg?raw';
import actionableMark from '../assets/brand/actionable-mark.svg?raw';

const route = Astro.locals.starlightRoute;
const { data } = route.entry;
const home = route.id === '' && Boolean(data.hero);
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const dark = image && 'dark' in image ? image.dark : undefined;
const light = image && 'light' in image ? image.light : undefined;

// A gem's own mark as a badge in the text colour, its dot in the spark: the brand file, recoloured, not a copy.
const badge = (svg: string) =>
  svg
    .replace(/ width="\d+" height="\d+" role="img"><title>[^<]*<\/title>/, ' class="af-gem" aria-hidden="true">')
    .replaceAll('stroke="#8a8174"', 'stroke="currentColor"')
    .replace('fill="#d4913f"', 'class="dot"');
const gemBadge = (href: string) =>
  href.includes('/gems/field_struct') ? badge(fieldStructMark) : href.includes('/gems/actionable') ? badge(actionableMark) : null;

// The docs map: one card per section, its page count read from the docs collection, so it can't go stale.
const docs = home ? await getCollection('docs') : [];
const count = (dir: string) => docs.filter((d) => d.id.startsWith(`${dir}/`) && !d.id.endsWith('/index') && d.id !== `${dir}/index`).length;
const sections = [
  { href: '/tutorial/trek-planner/', name: 'Tutorial', unit: 'parts', dir: 'tutorial', text: 'Build a small trek planner, one gem at a time.' },
  { href: '/how-to/', name: 'How-to guides', unit: 'guides', dir: 'how-to', text: 'Recipes for one task each: Rails, jobs, RBS, testing.' },
  { href: '/reference/', name: 'Reference', unit: 'pages', dir: 'reference', text: 'Every option, method and outcome, checked against the code.' },
  { href: '/explanation/', name: 'Explanation', unit: 'pages', dir: 'explanation', text: 'Why the gems are shaped the way they are.' },
  { href: '/adapters/', name: 'Adapters', unit: 'pages', dir: 'adapters', text: 'JSON Schema, Avro, Protobuf, OpenTelemetry, LLM tools, process pages.' },
].map((s) => ({ ...s, n: count(s.dir) }));
---

{
  home ? (
    <>
      <div class="hero af-hero">
        {/* Inlined here rather than imported, so only the home page carries the hero's CSS. */}
        <style is:inline set:html={heroCss + timelineCss} />
        <div class="sl-flex stack">
          <div class="sl-flex copy">
            <h1 id="_top" data-page-title>
              {dark && light && (
                <span class="af-hero-mark" aria-hidden="true">
                  <Image src={dark} alt="" width={64} height={64} loading="eager" class="light:sl-hidden" />
                  <Image src={light} alt="" width={64} height={64} loading="eager" class="dark:sl-hidden" />
                </span>
              )}
              <Fragment set:html={title} />
            </h1>
            {tagline && <div class="tagline" set:html={tagline} />}
          </div>
          {actions.length > 0 && (
            <div class="sl-flex actions">
              {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
                const gem = gemBadge(href);
                return (
                  <LinkButton {href} {variant} icon={icon?.name} class:list={[className, gem && 'af-gem-link']} {...attrs}>
                    {gem && <Fragment set:html={gem} />}
                    {text}
                    {icon?.html && <Fragment set:html={icon.html} />}
                  </LinkButton>
                );
              })}
            </div>
          )}
        </div>
        <div class="af-hero-demo" set:html={demo} />
      </div>
      <div class="af-idea">
        <section class="af-band" aria-label="The Gliders idea">
          <p>A glider has no engine. It stays up on the air that is already there. These gems try to work the same way: with your data and your system, not against them.</p>
          <a class="more" href="/explanation/gliders/">Why the name: the Gliders idea →</a>
        </section>
        <nav class="af-map" aria-label="What's in the docs">
          {sections.map((s) => (
            <a href={s.href}>
              <b>
                {s.name} <span>{s.n} {s.unit}</span>
              </b>
              {s.text}
            </a>
          ))}
        </nav>
      </div>
    </>
  ) : (
    <Default />
  )
}

<script>
  // The hero's stepper (src/hero/hero.mjs renders the figure, its steps and their CSS). The figure starts on its
  // last step, the finished picture, and autoplay moves to step 1 only once the figure is in view, so the static
  // figure, the end of each round, reduced motion and scripts off all show the same thing.
  const HOLD_MS = 6000; // the last step's dwell before the next round
  const ROUNDS = 3; // then it rests on the last step
  const fig = document.querySelector<HTMLElement>('[data-hx]');
  const bar = fig?.querySelector<HTMLElement>('.hx-steps');

  if (fig && bar) {
    const total = Number(fig.dataset.steps);
    const dwell = (fig.dataset.dwell ?? '').split(',').map((s) => Number(s) * 1000);
    const prev = bar.querySelector<HTMLButtonElement>('.hx-prev')!;
    const next = bar.querySelector<HTMLButtonElement>('.hx-next')!;
    const play = bar.querySelector<HTMLButtonElement>('.hx-play')!;
    const numbers = [...bar.querySelectorAll<HTMLButtonElement>('.hx-step')];
    const live = fig.querySelector<HTMLElement>('.hx-live');
    const calm = matchMedia('(prefers-reduced-motion: reduce)');

    let step = total;
    let auto = !calm.matches; // false once the reader drives, or asks for less motion
    let paused = false; // the reader pressed pause; nothing but the play button undoes it
    let inView = false;
    let started = false;
    let rounds = 0;
    let timer: number | undefined;

    const show = (n: number, announce = false) => {
      step = n;
      fig.dataset.step = String(n);
      numbers.forEach((b, i) => (i + 1 === n ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
      prev.disabled = n === 1;
      next.disabled = n === total;
      if (announce && live) live.textContent = fig.querySelector(`[data-cap="${n}"]`)?.textContent ?? '';
    };
    const running = () => auto && !paused && inView && !document.hidden;
    const showPlay = () => {
      const on = auto && !paused;
      play.dataset.state = on ? 'playing' : 'paused';
      play.setAttribute('aria-label', on ? 'Pause autoplay' : 'Play autoplay');
    };
    const stop = () => {
      clearTimeout(timer);
      timer = undefined;
    };
    const advance = () => {
      timer = undefined;
      if (step < total) show(step + 1);
      else if (++rounds >= ROUNDS) {
        auto = false; // rest on the finished picture
        showPlay();
        return;
      } else show(1);
      tick();
    };
    const tick = () => {
      if (!running()) return stop();
      if (!started) {
        started = true;
        show(1);
      }
      if (timer === undefined) timer = window.setTimeout(advance, step < total ? dwell[step - 1] : HOLD_MS);
    };
    // The reader takes over: autoplay stops for good, until the play button.
    const drive = (n: number) => {
      auto = false;
      stop();
      showPlay();
      show(Math.min(total, Math.max(1, n)), true);
    };

    prev.addEventListener('click', () => drive(step - 1));
    next.addEventListener('click', () => drive(step + 1));
    numbers.forEach((b, i) => b.addEventListener('click', () => drive(i + 1)));
    bar.addEventListener('keydown', (e) => {
      const to = { ArrowLeft: step - 1, ArrowRight: step + 1, Home: 1, End: total }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      drive(to);
    });
    play.addEventListener('click', () => {
      if (auto && !paused) {
        paused = true;
        stop();
      } else {
        auto = true;
        paused = false;
        if (rounds >= ROUNDS) rounds = 0;
        started = true;
        if (step === total) show(1);
      }
      showPlay();
      tick();
    });

    new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio >= 0.6) inView = true;
        else if (entry.intersectionRatio < 0.25) inView = false;
        tick();
      },
      { threshold: [0, 0.25, 0.6, 1] },
    ).observe(fig);
    document.addEventListener('visibilitychange', tick);
    calm.addEventListener('change', () => {
      if (!calm.matches) return;
      auto = false;
      stop();
      play.hidden = true;
    });

    play.hidden = calm.matches; // reduced motion: the stepper works, nothing advances by itself
    bar.hidden = false;
    show(total);
    showPlay();
  }
</script>
