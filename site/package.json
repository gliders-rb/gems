{
  "name": "gems-docs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:code": "bin/check-code-blocks",
    "check:links": "bin/check-links",
    "check:ids": "bin/check-rule-ids",
    "hero": "bin/hero build",
    "check:hero": "node --test 'test/*.test.mjs' && bin/hero check",
    "hero:pdf": "bin/hero pdf dist-hero/gliders-hero.pdf",
    "hero:gif": "bin/hero gif dist-hero/hero-dark.gif --theme dark && bin/hero gif dist-hero/hero-light.gif --theme light",
    "hero:video": "bin/hero video dist-hero/gliders-hero.mp4",
    "hero:readme": "bin/hero readme",
    "test:hero-browser": "astro build && node --test test/hero.browser.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.4",
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.10",
    "sharp": "0.35.5",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "gifenc": "1.0.3",
    "playwright": "1.65.1",
    "shiki": "4.6.0",
    "yaml": "2.9.1"
  }
}
