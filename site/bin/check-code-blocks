#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the runnable Ruby fences of every page, through the monorepo's doc-test runner (tools/doctest).
#
#   bin/check-code-blocks                 # every page under src/content/docs, and the hero storyboard
#   bin/check-code-blocks FILE [FILE...]  # only these pages
#
# A fence is runnable when its language is `ruby` and its meta has the word `run`. All runnable blocks of one page
# run in order in one fresh Ruby process that shares classes, constants and locals, with field_struct and actionable
# already required. `expr # => expected`, or a `# =>` line under the expression, is an assertion. Pages under
# adapters/ use Gemfile.edge (or $SITE_EDGE_GEMFILE), every other page uses Gemfile.
require 'pathname'
require_relative '../../tools/doctest/lib/doctest'

SITE = Pathname.new(__dir__).join('..').expand_path
DOCS = SITE.join('src/content/docs')
# The landing animation's storyboard (src/hero) runs like a page: everything the animation shows is asserted there.
HERO = SITE.join('src/hero')
Dir.chdir(SITE)

def gemfile_for(path)
  if path.start_with?("#{DOCS}/adapters/")
    ENV.fetch('SITE_EDGE_GEMFILE', SITE.join('Gemfile.edge').to_s)
  else
    SITE.join('Gemfile').to_s
  end
end

files = if ARGV.empty?
          Dir[DOCS.join('**/*.{md,mdx}').to_s] + Dir[HERO.join('*.md').to_s]
        else
          ARGV.map { |f| File.expand_path(f) }
        end
total = 0
failed = []
files.sort.each do |file|
  rel = Pathname.new(file).relative_path_from(SITE).to_s
  begin
    run = Doctest.run_file(rel, requires: %w[field_struct actionable], gemfile: gemfile_for(file))
  rescue ArgumentError => e
    puts "FAIL #{rel}"
    warn e.message
    failed << rel
    next
  end
  next if run.blocks.zero?

  total += run.blocks
  puts "#{run.ok ? 'ok  ' : 'FAIL'} #{rel} (#{run.blocks} blocks)"
  next if run.ok

  warn run.stderr
  failed << rel
end

if total.zero? && failed.empty?
  warn 'check-code-blocks: no runnable blocks found'
  exit 1
end
if failed.any?
  warn "check-code-blocks: #{failed.size} page(s) failed"
  exit 1
end
puts "check-code-blocks: #{total} blocks passed"
