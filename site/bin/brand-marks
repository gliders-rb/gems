#!/usr/bin/env node
// Draws the Gliders brand marks (direction C, "Thermal") from a few geometry constants.
// Run from site/: bin/brand-marks. Writes SVGs and PNGs to src/assets/brand and public/brand.
//
// - Gliders: a column of rising air drawn as a coil that widens as it climbs, with the glider
//   as one dot riding out of the top.
// - field_struct and actionable: a ring with the dot on it, the ring touching the dot from
//   behind and open just ahead of it, with the gem's letters (FS, Ac) in the centre. The
//   letters are monoline strokes, not text, so the files need no font.
import { mkdirSync, writeFileSync } from 'node:fs';
import sharp from 'sharp';

const AMBER = '#d4913f'; // the dot, in files shown on any background (READMEs, PNGs)
const STONE = '#8a8174'; // the line work in those files
const THEMES = {
  dark: { ink: '#ece6dc', dot: '#e2a65c' }, // the site's text white and accent, dark scheme
  light: { ink: '#1a1612', dot: '#c47a1e' }, // the same, light scheme
};
const LINE = 2.6;

const f = (n) => Number(n.toFixed(2));
const polyline = (pts) => pts.map((p, i) => `${i ? 'L' : 'M'}${f(p[0])} ${f(p[1])}`).join(' ');

// Side view: a coil rising from the bottom and widening, ending top right.
function coil(turns, r0, grow, rise, base) {
  const steps = Math.round(turns * 48);
  const pts = [];
  for (let i = 0; i <= steps; i += 1) {
    const t = (i / steps) * turns;
    const a = Math.PI * 2 * t + Math.PI;
    const r = r0 + grow * t;
    pts.push([32 + r * Math.cos(a), base - rise * t + r * 0.36 * Math.sin(a)]);
  }
  return { d: polyline(pts), tip: pts.at(-1) };
}

// Top view: a full ring with the dot on it at -45 degrees (top right). The ring runs into the
// dot from behind and stops short of it ahead, so the dot reads as moving clockwise.
function ring(gap = 28, r = 26) {
  const at = (deg) => [32 + r * Math.cos((deg * Math.PI) / 180), 32 + r * Math.sin((deg * Math.PI) / 180)];
  const start = at(-45 + gap);
  const tip = at(-45);
  return { d: `M${f(start[0])} ${f(start[1])} A${r} ${r} 0 1 1 ${f(tip[0])} ${f(tip[1])}`, tip };
}

// Monoline letters in an 8 x 13 box whose top-left corner is (x, y).
const glyphs = {
  F: (x, y) => `M${x} ${y + 13} V${y} H${x + 8} M${x} ${y + 6} H${x + 6.2}`,
  S: (x, y) =>
    `M${x + 7.6} ${y + 1.8} C${x + 6.4} ${y - 0.2} ${x + 0.8} ${y - 0.2} ${x + 0.6} ${y + 3.2} ` +
    `C${x + 0.4} ${y + 6.2} ${x + 7.8} ${y + 6.4} ${x + 7.6} ${y + 9.8} ` +
    `C${x + 7.4} ${y + 13.3} ${x + 1.4} ${y + 13.3} ${x + 0.3} ${y + 11.2}`,
  A: (x, y) => `M${x} ${y + 13} L${x + 4} ${y} L${x + 8} ${y + 13} M${x + 1.6} ${y + 8.6} H${x + 6.4}`,
  c: (x, y) => {
    const cx = x + 4;
    const cy = y + 8.5;
    const dx = f(4.5 * Math.cos(Math.PI / 4.5));
    const dy = f(4.5 * Math.sin(Math.PI / 4.5));
    return `M${f(cx + dx)} ${f(cy - dy)} A4.5 4.5 0 1 0 ${f(cx + dx)} ${f(cy + dy)}`;
  },
};
const letters = (pair) => `${glyphs[pair[0]](22.5, 25.5)} ${glyphs[pair[1]](33.5, 25.5)}`;

const stroke = (d, colour, width = LINE) =>
  `<path d="${d}" fill="none" stroke="${colour}" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round"/>`;
const dot = ([x, y], r, colour) => `<circle cx="${f(x)}" cy="${f(y)}" r="${r}" fill="${colour}"/>`;

function gliders({ ink, dot: d }) {
  const c = coil(2.6, 3, 22 / 2.6, 34 / 2.6, 53);
  return stroke(c.d, ink, 2.2) + dot(c.tip, 3.6, d);
}

// Avatar cut (GitHub org, social): the full coil with a heavier line and dot, so it still reads
// at 20-40px.
function glidersAvatar({ ink, dot: d }) {
  const c = coil(2.6, 3, 22 / 2.6, 34 / 2.6, 53);
  return stroke(c.d, ink, 3.2) + dot(c.tip, 4.6, d);
}
function glidersSmall({ ink, dot: d }) {
  const c = coil(1.6, 5, 15, 21, 52);
  return stroke(c.d, ink, 6.5) + dot(c.tip, 7.5, d);
}
function gem(pair, { ink, dot: d }) {
  const o = ring();
  const text = `<g transform="translate(32 32) scale(1.55) translate(-32 -32)">${stroke(letters(pair), ink, 1.75)}</g>`;
  return stroke(o.d, ink) + dot(o.tip, 4.6, d) + text;
}

const svg = (w, h, body, title) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w * 2}" height="${h * 2}" role="img"><title>${title}</title>${body}</svg>\n`;

const colour = { ink: STONE, dot: AMBER };
const mono = { ink: 'currentColor', dot: 'currentColor' };
const favicon =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><title>Gliders</title>' +
  `<style>.i{stroke:${THEMES.light.ink}}@media (prefers-color-scheme: dark){.i{stroke:${THEMES.dark.ink}}}</style>` +
  glidersSmall({ ink: 'X', dot: AMBER }).replace('stroke="X"', 'class="i"') +
  '</svg>\n';

const files = {
  'gliders-mark.svg': svg(64, 64, gliders(colour), 'Gliders'),
  'gliders-mark-dark.svg': svg(64, 64, gliders(THEMES.dark), 'Gliders'),
  'gliders-mark-light.svg': svg(64, 64, gliders(THEMES.light), 'Gliders'),
  'gliders-mark-mono.svg': svg(64, 64, gliders(mono), 'Gliders'),
  'gliders-avatar.svg': svg(64, 64, glidersAvatar(THEMES.dark), 'Gliders'),
  'field-struct-mark.svg': svg(64, 64, gem('FS', colour), 'field_struct'),
  'actionable-mark.svg': svg(64, 64, gem('Ac', colour), 'actionable'),
  'field-struct-mark-mono.svg': svg(64, 64, gem('FS', mono), 'field_struct'),
  'actionable-mark-mono.svg': svg(64, 64, gem('Ac', mono), 'actionable'),
  'pair.svg': svg(
    136,
    64,
    `<g>${gem('FS', colour)}</g><g transform="translate(72 0)">${gem('Ac', colour)}</g>`,
    'field_struct and actionable',
  ),
  'favicon.svg': favicon,
};

for (const dir of ['src/assets/brand', 'public/brand']) {
  mkdirSync(dir, { recursive: true });
  for (const [name, body] of Object.entries(files)) writeFileSync(`${dir}/${name}`, body);
}

const png = async (name, size, src, { pad = 0, background } = {}) => {
  const inner = size - pad * 2;
  const img = await sharp(Buffer.from(files[src]), { density: 600 }).resize(inner, inner).png().toBuffer();
  const base = sharp({
    create: { width: size, height: size, channels: 4, background: background ?? { r: 0, g: 0, b: 0, alpha: 0 } },
  });
  await base.composite([{ input: img, top: pad, left: pad }]).png().toFile(`public/brand/${name}`);
};
await png('gliders-mark-512.png', 512, 'gliders-mark.svg');
await png('field-struct-mark-512.png', 512, 'field-struct-mark.svg');
await png('actionable-mark-512.png', 512, 'actionable-mark.svg');
await png('apple-touch-icon.png', 180, 'gliders-mark-dark.svg', { pad: 24, background: '#14120f' });
await png('gliders-avatar.png', 512, 'gliders-avatar.svg', { pad: 24, background: '#14120f' });
console.log('brand marks written');
