# frozen_string_literal: true

# The ActiveSupport lane (rake spec:active_support): the suite runs with ActiveSupport loaded before the gem.
source 'https://rubygems.org'

gemspec path: '..'

gem 'activesupport', ENV.fetch('FIELD_STRUCT_AS_VERSION', '>= 7.2')
gem 'rake', '~> 13.0'
gem 'rbs', '~> 3.0'
gem 'rspec', '~> 3.0'
