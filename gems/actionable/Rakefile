# frozen_string_literal: true

require 'rspec/core/rake_task'
require 'rubocop/rake_task'

# Each adapter's specs load that adapter (and Rails) into the process, so they run apart from the core suite.
ADAPTER_SPEC_DIRS = %w[rails job coverage adapter_sigs].freeze

# The doctests start a Ruby process per example block; they run in release:check (docs:test).
RSpec::Core::RakeTask.new(:spec) do |task|
  task.rspec_opts = '--tag ~doctest'
  task.exclude_pattern = "spec/{#{ADAPTER_SPEC_DIRS.join(',')}}/**/*_spec.rb"
end

namespace :spec do
  ADAPTER_SPEC_DIRS.each do |dir|
    desc "Run the #{dir} adapter specs in their own process"
    RSpec::Core::RakeTask.new(dir) do |task|
      task.pattern = "spec/#{dir}/**/*_spec.rb"
      task.rspec_opts = '--tag ~doctest'
    end
  end
end

RuboCop::RakeTask.new(:rubocop)

task default: ['spec', *ADAPTER_SPEC_DIRS.map { |dir| "spec:#{dir}" }, 'rubocop']
