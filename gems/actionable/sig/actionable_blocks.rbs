# Hand-written (AC-B#rbsshipped). The DSL methods below run their block with a different self, which the generated
# signature cannot express. Each `| ...` adds a block-self overload to the one generated in actionable.rbs.
module Actionable
  class Action
    def self.output: () ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> Class? | ...
    def self.input: () ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> Class? | ...
    def self.input_for: ((Symbol | String) discriminator) ?{ () [self: Actionable::InputDispatch::Builder] -> void } -> Actionable::InputDispatch | ...
    def self.case_step: ((Symbol | String) value_source, **Object options) ?{ () [self: Actionable::Steps::Case::Builder] -> void } -> ::Set[Actionable::Steps::Base] | ...
    def self.fails: ((Symbol | String) code, ?String? message, **Object metadata) ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> ::Hash[Symbol, ::Hash[Symbol, Object]] | ...
    def self.skips: ((Symbol | String) code, ?String? message, **Object metadata) ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> ::Hash[Symbol, ::Hash[Symbol, Object]] | ...
  end

  module SchemaMacros
    def output: () ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> Class? | ...
    def input: () ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> Class? | ...
    def input_for: ((Symbol | String) discriminator) ?{ () [self: Actionable::InputDispatch::Builder] -> void } -> Actionable::InputDispatch | ...
  end

  module DeclarationMacros
    def fails: ((Symbol | String) code, ?String? message, **Object metadata) ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> ::Hash[Symbol, ::Hash[Symbol, Object]] | ...
    def skips: ((Symbol | String) code, ?String? message, **Object metadata) ?{ () [self: singleton(::FieldStruct::Base)] -> void } -> ::Hash[Symbol, ::Hash[Symbol, Object]] | ...
  end

  class InputDispatch
    def self.define: ((Symbol | String) discriminator) ?{ () [self: Actionable::InputDispatch::Builder] -> void } -> InputDispatch | ...
  end

  module Steps
    class Case
      def self.define: ((Symbol | String) value_source, **Object options) ?{ () [self: Actionable::Steps::Case::Builder] -> void } -> Steps::Case | ...
    end
  end
end
